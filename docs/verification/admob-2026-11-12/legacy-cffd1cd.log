// @dart = 2.12.0

import 'package:flutter/cupertino.dart';
import 'package:flutter/material.dart';
import 'package:google_mobile_ads/google_mobile_ads.dart';
import 'package:numerology/config/color/color.dart';
import 'package:numerology/utils/ads_util.dart';
import 'package:numerology/utils/connection_utils.dart';

import '../commons/widgets/toast.dart';
import '../generated/l10n.dart';
import '../utils/app_utils.dart';
const int maxFailedLoadAttempts = 3;

abstract class BaseState<T extends StatefulWidget> extends State<T> {
  late BannerAd bannerAd;
  InterstitialAd? interstitialAd;
  int _numInterstitialLoadAttempts = 0;
  bool isLoadAdsError = false;
  late NativeAd nativeAd;
  bool nativeAdIsLoaded = false;

  // final adContainer = ConstrainedBox(
  //   constraints: const BoxConstraints(
  //     minWidth: 320, // minimum recommended width
  //     minHeight: 90, // minimum recommended height
  //     maxWidth: 400,
  //     maxHeight: 200,
  //   ),
  //   child: AdWidget(ad: _nativeAd),
  // );

  static final AdRequest request = AdRequest(
    keywords: <String>['foo', 'bar'],
    contentUrl: 'http://foo.com/bar.html',
    nonPersonalizedAds: true,
  );


  /// Loads a native ad.
  void createAdNative() {
    nativeAd = NativeAd(
        adUnitId: AdsUtil.nativeAdsId,
        listener: NativeAdListener(
          onAdLoaded: (ad) {
            debugPrint('$NativeAd loaded.');
            setState(() {
              nativeAdIsLoaded = true;
            });
          },
          onAdFailedToLoad: (ad, error) {
            // Dispose the ad here to free resources.
            debugPrint('$NativeAd failed to load: $error');
            ad.dispose();
          },
        ),
        request: const AdRequest(),
        // Styling
        nativeTemplateStyle: NativeTemplateStyle(
          // Required: Choose a template.
            templateType: TemplateType.small,
            // Optional: Customize the ad's style.
            mainBackgroundColor: Colors.white,
            cornerRadius: 10.0,
            callToActionTextStyle: NativeTemplateTextStyle(
              textColor: AppColors.colorWhitef7,
              backgroundColor: AppColors.colorAccent,
              style: NativeTemplateFontStyle.normal,
              size: 16.0),
            primaryTextStyle: NativeTemplateTextStyle(
                textColor: AppColors.colorAccent,
                backgroundColor: Colors.white,
                style: NativeTemplateFontStyle.italic,
                size: 16.0),
            secondaryTextStyle: NativeTemplateTextStyle(
                textColor: AppColors.colorBlack1,
                backgroundColor: Colors.white,
                style: NativeTemplateFontStyle.bold,
                size: 16.0),
            tertiaryTextStyle: NativeTemplateTextStyle(
                textColor: Colors.brown,
                backgroundColor: Colors.white,
                style: NativeTemplateFontStyle.normal,
                size: 16.0),
            ))
      ..load();
  }

  BannerAd createBannerAd() {
    return BannerAd(
      adUnitId: AdsUtil.bannerAdsId,
      size: AdSize.banner,
      request: request,
      listener: BannerAdListener(),
    );
  }

  Future<void> createInterstitialAd() async {
    await InterstitialAd.load(
        adUnitId:AdsUtil.interstitialAdsId,
        request: request,
        adLoadCallback: InterstitialAdLoadCallback(
          onAdLoaded: (InterstitialAd ad) {
            print('$ad loaded');
            interstitialAd = ad;
            _numInterstitialLoadAttempts = 0;
            interstitialAd?.setImmersiveMode(true);
          },
          onAdFailedToLoad: (LoadAdError error) async {
            isLoadAdsError = true;
            print('InterstitialAd failed to load: $error.');
            _numInterstitialLoadAttempts += 1;
            interstitialAd = null;
            if (_numInterstitialLoadAttempts < maxFailedLoadAttempts) {
              createInterstitialAd();
            }
          },
        ));
  }
  @override
  void initState() {
    super.initState();
    createInterstitialAd();
    // if (useAdBanner()) bannerAd = createBannerAd()..load();
    // if (useAdInterstitial()) interstitialAd = createInterstitialAd()..load();
  }


  @override
  void didChangeDependencies() {
    super.didChangeDependencies();
    if (useAdBanner()) {
      // bannerAd ??= createBannerAd();
      // bannerAd
      //   ..load();

    }
  }

  @override
  void dispose() {
    bannerAd?.dispose();
    super.dispose();
  }

  bool useAdBanner() {
    return false;
  }

  bool useAdInterstitial() {
    return false;
  }

  Future<void> showInterstitialAd() async {
    await createInterstitialAd();
    if (interstitialAd == null) {
      print('Warning: attempt to show interstitial before loaded.');
      return;
    }
    interstitialAd?.fullScreenContentCallback = FullScreenContentCallback(
      onAdShowedFullScreenContent: (InterstitialAd ad) =>
          print('ad onAdShowedFullScreenContent.'),
      onAdDismissedFullScreenContent: (InterstitialAd ad) {
        print('$ad onAdDismissedFullScreenContent.');
        ad.dispose();
        createInterstitialAd();
      },
      onAdFailedToShowFullScreenContent: (InterstitialAd ad, AdError error) {
        print('$ad onAdFailedToShowFullScreenContent: $error');
        ad.dispose();
        createInterstitialAd();
      },
    );
    interstitialAd?.show();
    interstitialAd = null;
  }

  void onInterstitialAdClosed() {}
}
